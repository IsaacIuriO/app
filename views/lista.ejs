<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista</title>
</head>
<body>
    <h1>Lista de Itens</h1>

    <table>
        <thead>
            <tr>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% for(let dado of dados) { %>
                <tr>
                    <td><%= dado.nome %></td>
                    <td><%= dado.descricao %></td>
                    <td> <a href="/categoria/editar/<%= dado.id %>">Editar</a> </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>